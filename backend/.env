# ============================================================================
# Flask API 服务配置 SECRET_KEY必须配置!
# ============================================================================
SECRET_KEY=dev-secret-key-12345
# 开发模式开关
FLASK_DEBUG=true

# ============================================================================
# PostgreSQL / pgvector 配置
# ============================================================================
# 如果你使用本地安装的 PostgreSQL，默认端口通常是 5432
# APP_DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/ctb
# 如果你使用 Docker 启动 (pgsql.txt 中的方式)，请使用下面的连接串：
APP_DATABASE_URL=postgresql+psycopg://postgres:root@localhost:15432/ctb
APP_DATABASE_ECHO=false
# OpenAI Embedding 维度通常为 1536 (text-embedding-3-small)
APP_POSTGRES_VECTOR_DIMENSIONS=1024

# ============================================================================
# 平台托管 Provider 默认配置
# ============================================================================
# 请在此处填写你的 API Key 以启用 RAG 向量生成和 AI 对话
# APP_DEFAULT_OPENAI_API_KEY=sk-xxxx
# APP_DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
# APP_DEFAULT_OPENAI_MODEL_NAME=gpt-4o-mini

# APP_DEFAULT_PADDLEOCR_API_URL=
# APP_DEFAULT_PADDLEOCR_API_TOKEN=

# ============================================================================
# RAG 语义检索配置
# ============================================================================
# 阿里云 DashScope Embedding 模型 (text-embedding-v3 维度为 1024)
APP_RAG_EMBEDDING_MODEL=text-embedding-v3
APP_RAG_EMBEDDING_API_KEY=sk-9851cd27d3994a0dabe0335b9bdb1946
APP_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 数据库向量维度：若使用 text-embedding-v3，请确保下方维度设为 1024
APP_POSTGRES_VECTOR_DIMENSIONS=1024
